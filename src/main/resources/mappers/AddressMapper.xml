<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.ecommerce.dao.AddressMapper">

    <!-- ===================================================== -->
    <!-- Result Map -->
    <!-- ===================================================== -->

    <resultMap id="AddressResultMap"
               type="com.crimsonlogic.ecommerce.model.Address">

        <id property="addressId"
            column="address_id"/>

        <result property="houseNumber"
                column="house_number"/>

        <result property="street"
                column="street"/>

        <result property="city"
                column="city"/>

        <result property="state"
                column="state"/>

        <result property="country"
                column="country"/>

        <result property="zipCode"
                column="zip_code"/>

    </resultMap>


    <!-- ===================================================== -->
    <!-- INSERT ADDRESS -->
    <!-- ===================================================== -->

    <insert id="insertAddress"
            parameterType="com.crimsonlogic.ecommerce.model.Address">

        INSERT INTO address
        (
        address_id,
        house_number,
        street,
        city,
        state,
        country,
        zip_code
        )
        VALUES
        (
        #{addressId},
        #{houseNumber},
        #{street},
        #{city},
        #{state},
        #{country},
        #{zipCode}
        )

    </insert>


    <!-- ===================================================== -->
    <!-- UPDATE ADDRESS -->
    <!-- ===================================================== -->

    <update id="updateAddress"
            parameterType="com.crimsonlogic.ecommerce.model.Address">

        UPDATE address
        SET
        house_number = #{houseNumber},
        street = #{street},
        city = #{city},
        state = #{state},
        country = #{country},
        zip_code = #{zipCode}
        WHERE address_id = #{addressId}

    </update>


    <!-- ===================================================== -->
    <!-- DELETE ADDRESS -->
    <!-- ===================================================== -->

    <delete id="deleteAddress"
            parameterType="String">

        DELETE FROM address
        WHERE address_id = #{addressId}

    </delete>


    <!-- ===================================================== -->
    <!-- FIND ADDRESS BY ID -->
    <!-- ===================================================== -->

    <select id="findAddressById"
            parameterType="String"
            resultMap="AddressResultMap">

        SELECT
        address_id,
        house_number,
        street,
        city,
        state,
        country,
        zip_code
        FROM address
        WHERE address_id = #{addressId}

    </select>


    <!-- ===================================================== -->
    <!-- FIND ALL ADDRESSES -->
    <!-- ===================================================== -->

    <select id="findAllAddresses"
            resultMap="AddressResultMap">

        SELECT
        address_id,
        house_number,
        street,
        city,
        state,
        country,
        zip_code
        FROM address
        ORDER BY city, state

    </select>

	

<select id="findAddressesByCustomer"
        resultMap="AddressResultMap">

    SELECT
        a.address_id,
        a.house_number,
        a.street,
        a.city,
        a.state,
        a.country,
        a.zip_code

    FROM address a

    INNER JOIN customer_address ca
        ON a.address_id = ca.address_id

    WHERE ca.customer_id = #{customerId}

    ORDER BY a.city, a.state

</select>




	<insert id="assignAddressToCustomer">
	
	    INSERT INTO customer_address
	    (
	        customer_id,
	        address_id
	    )
	    VALUES
	    (
	        #{customerId},
	        #{addressId}
	    )
	
	</insert>
	
	
	<delete id="removeAddressFromCustomer">
	
	    DELETE FROM customer_address
	
	    WHERE customer_id = #{customerId}
	
	    AND address_id = #{addressId}
	
	</delete>
</mapper>