<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:mvc="http://www.springframework.org/schema/mvc"
	xsi:schemaLocation=" http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans.xsd
http://www.springframework.org/schema/context
http://www.springframework.org/schema/context/spring-context.xsd
http://www.springframework.org/schema/mvc
http://www.springframework.org/schema/mvc/spring-mvc.xsd">

	<!-- Add support for component scanning (it scans all controllers) which 
		are defined using @Controller annotation -->

	<context:component-scan
		base-package="com.crimsonlogic.ecommerce" />
	<!-- Add support for conversion, formatting and validation support -->

	<mvc:annotation-driven />
	<!-- Define Spring MVC view resolver -->
	
	<mvc:resources
        mapping="/resources/**"
        location="/resources/" />

	<bean
		class="org.springframework.web.servlet.view.InternalResourceViewResolver">
		<property name="prefix" value="/WEB-INF/views/" />
		<property name="suffix" value=".jsp" />
	</bean>


	<!-- DATA SOURCE -->
	<bean id="dataSource"
		class="org.springframework.jdbc.datasource.DriverManagerDataSource">
		<property name="driverClassName"
			value="com.mysql.cj.jdbc.Driver" />
		<property name="url"
			value="jdbc:mysql://localhost:3306/ecommerceusingjsp" />
		<property name="username" value="root" />
		<property name="password" value="Prajwal@0103" />
	</bean>

	<!-- SQL Session Factory for mybatis -->
	<bean id="sqlSessionFactory"
		class="org.mybatis.spring.SqlSessionFactoryBean">
		<property name="dataSource" ref="dataSource" />
		<property name="mapperLocations"
			value="classpath:mappers/*.xml" />
			
			<property name="configuration">
    <bean class="org.apache.ibatis.session.Configuration">
        <property name="mapUnderscoreToCamelCase"
                  value="true"/>
    </bean>
</property>
	</bean>

	<!-- 3. Scan for Mapper Interfaces -->
	<bean class="org.mybatis.spring.mapper.MapperScannerConfigurer">
		<property name="basePackage"
			value="com.crimsonlogic.ecommerce.dao" />
		<property name="sqlSessionFactory" ref="sqlSessionFactory" />
	</bean>

	<bean id="addressService"
		class="com.crimsonlogic.ecommerce.service.impl.AddressServiceImpl">

		<property name="addressMapper" ref="addressMapper" />

	</bean>

	<bean id="authenticationService"
		class="com.crimsonlogic.ecommerce.service.impl.AuthenticationServiceImpl">

		<property name="adminMapper" ref="adminMapper" />

		<property name="customerMapper" ref="customerMapper" />

		<property name="sellerMapper" ref="sellerMapper" />

	</bean>
	
	<bean id="adminService"
		class="com.crimsonlogic.ecommerce.service.impl.AdminServiceImpl">

		<property name="adminMapper" ref="adminMapper" />

	</bean>

	<bean id="cartService"
		class="com.crimsonlogic.ecommerce.service.impl.CartServiceImpl">

		<property name="cartMapper" ref="cartMapper" />

	</bean>
	<bean id="categoryService"
		class="com.crimsonlogic.ecommerce.service.impl.CategoryServiceImpl">

		<property name="categoryMapper" ref="categoryMapper" />

	</bean>
	<bean id="customerService"
		class="com.crimsonlogic.ecommerce.service.impl.CustomerServiceImpl">

		<property name="customerMapper" ref="customerMapper" />

	</bean>
	<bean id="inventoryService"
		class="com.crimsonlogic.ecommerce.service.impl.InventoryServiceImpl">

		<property name="inventoryMapper" ref="inventoryMapper" />

	</bean>
	<bean id="orderService"
		class="com.crimsonlogic.ecommerce.service.impl.OrderServiceImpl">

		<property name="orderMapper" ref="orderMapper" />

	</bean>

	<bean id="paymentService"
		class="com.crimsonlogic.ecommerce.service.impl.PaymentServiceImpl">

		<property name="paymentMapper" ref="paymentMapper" />

	</bean>
	<bean id="productService"
		class="com.crimsonlogic.ecommerce.service.impl.ProductServiceImpl">

		<property name="productMapper" ref="productMapper" />

	</bean>
	<bean id="reportService"
		class="com.crimsonlogic.ecommerce.service.impl.ReportServiceImpl">

		<property name="reportMapper" ref="reportMapper" />

	</bean>
	<bean id="reviewService"
		class="com.crimsonlogic.ecommerce.service.impl.ReviewServiceImpl">

		<property name="reviewMapper" ref="reviewMapper" />

	</bean>

	<bean id="sellerService"
		class="com.crimsonlogic.ecommerce.service.impl.SellerServiceImpl">

		<property name="sellerMapper" ref="sellerMapper" />

	</bean>



</beans>