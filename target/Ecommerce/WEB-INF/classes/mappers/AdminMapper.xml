<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.ecommerce.dao.AdminMapper">


    <!-- ===================================================== -->
    <!-- ADMIN RESULT MAP -->
    <!-- ===================================================== -->

    <resultMap id="adminResultMap"
               type="com.crimsonlogic.ecommerce.model.Admin">

        <id property="userId"
            column="user_id"/>

        <result property="userName"
                column="user_name"/>

        <result property="userEmail"
                column="user_email"/>

        <result property="userPhNo"
                column="user_phone"/>

        <result property="userPassword"
                column="user_password"/>

    </resultMap>


    <!-- ===================================================== -->
    <!-- CUSTOMER RESULT MAP FOR ADMIN -->
    <!-- ===================================================== -->

    <resultMap id="adminCustomerResultMap"
               type="com.crimsonlogic.ecommerce.model.Customer">

        <id property="userId"
            column="user_id"/>

        <result property="userName"
                column="user_name"/>

        <result property="userEmail"
                column="user_email"/>

        <result property="userPhNo"
                column="user_phone"/>

        <result property="userPassword"
                column="user_password"/>

        <result property="walletBalance"
                column="wallet_balance"/>

    </resultMap>


    <!-- ===================================================== -->
    <!-- SELLER RESULT MAP FOR ADMIN -->
    <!-- ===================================================== -->

    <resultMap id="adminSellerResultMap"
               type="com.crimsonlogic.ecommerce.model.Seller">

        <id property="userId"
            column="user_id"/>

        <result property="userName"
                column="user_name"/>

        <result property="userEmail"
                column="user_email"/>

        <result property="userPhNo"
                column="user_phone"/>

        <result property="userPassword"
                column="user_password"/>

        <result property="shopName"
                column="shop_name"/>

        <result property="shopAddress"
                column="shop_address"/>

    </resultMap>


    <!-- ===================================================== -->
    <!-- FIND ADMIN BY EMAIL -->
    <!-- ===================================================== -->

    <select id="findAdminByEmail"
            resultMap="adminResultMap">

        SELECT
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password
        FROM admins
        WHERE user_email = #{email}

    </select>


    <!-- ===================================================== -->
    <!-- FIND ADMIN BY PHONE -->
    <!-- ===================================================== -->

    <select id="findAdminByPhone"
            resultMap="adminResultMap">

        SELECT
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password
        FROM admins
        WHERE user_phone = #{phone}

    </select>


    <!-- ===================================================== -->
    <!-- FIND ADMIN BY ID -->
    <!-- ===================================================== -->

    <select id="findAdminById"
            resultMap="adminResultMap">

        SELECT
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password
        FROM admins
        WHERE user_id = #{adminId}

    </select>


    <!-- ===================================================== -->
    <!-- FIND ALL ADMINS -->
    <!-- ===================================================== -->

    <select id="findAllAdmins"
            resultMap="adminResultMap">

        SELECT
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password
        FROM admins

    </select>


    <!-- ===================================================== -->
    <!-- INSERT ADMIN -->
    <!-- ===================================================== -->

    <insert id="insertAdmin">

        INSERT INTO admins
        (
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password
        )
        VALUES
        (
            #{userId},
            #{userName},
            #{userEmail},
            #{userPhNo},
            #{userPassword}
        )

    </insert>


    <!-- ===================================================== -->
    <!-- UPDATE ADMIN PHONE -->
    <!-- ===================================================== -->

    <update id="updateAdminPhone">

        UPDATE admins
        SET user_phone = #{userPhNo}
        WHERE user_id = #{userId}

    </update>


    <!-- ===================================================== -->
    <!-- UPDATE ADMIN PASSWORD -->
    <!-- ===================================================== -->

    <update id="updateAdminPassword">

        UPDATE admins
        SET user_password = #{userPassword}
        WHERE user_id = #{userId}

    </update>


    <!-- ===================================================== -->
    <!-- CUSTOMER MANAGEMENT -->
    <!-- ===================================================== -->

    <select id="findAllCustomers"
            resultMap="adminCustomerResultMap">

        SELECT
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password,
            wallet_balance
        FROM customers
        ORDER BY user_name

    </select>


    <delete id="deleteCustomer">

        DELETE FROM customers
        WHERE user_id = #{customerId}

    </delete>


    <!-- ===================================================== -->
    <!-- SELLER MANAGEMENT -->
    <!-- ===================================================== -->

    <select id="findAllSellers"
            resultMap="adminSellerResultMap">

        SELECT
            user_id,
            user_name,
            user_email,
            user_phone,
            user_password,
            shop_name,
            shop_address
        FROM sellers
        ORDER BY user_name

    </select>


    <delete id="deleteSeller">

        DELETE FROM sellers
        WHERE user_id = #{sellerId}

    </delete>


</mapper>