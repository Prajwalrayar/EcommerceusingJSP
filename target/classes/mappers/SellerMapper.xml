<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.ecommerce.dao.SellerMapper">


    <!-- ===================================================== -->
    <!-- Seller Result Map -->
    <!-- ===================================================== -->

    <resultMap id="SellerResultMap"
               type="com.crimsonlogic.ecommerce.model.Seller">

        <id property="userId"
            column="user_id"/>

        <result property="userName"
                column="user_name"/>

        <result property="userEmail"
                column="user_email"/>

        <result property="userPhNo"
                column="user_phone"/>

        <result property="userPassword"
                column="user_password"/>

        <result property="shopName"
                column="shop_name"/>

        <result property="shopAddress"
                column="shop_address"/>

    </resultMap>


    <!-- ===================================================== -->
    <!-- Address Result Map -->
    <!-- ===================================================== -->

    <resultMap id="AddressResultMap"
               type="com.crimsonlogic.ecommerce.model.Address">

        <id property="addressId"
            column="address_id"/>

        <result property="houseNumber"
                column="house_number"/>

        <result property="street"
                column="street"/>

        <result property="city"
                column="city"/>

        <result property="state"
                column="state"/>

        <result property="country"
                column="country"/>

        <result property="zipCode"
                column="zip_code"/>

    </resultMap>


    <!-- ===================================================== -->
    <!-- Insert Seller -->
    <!-- ===================================================== -->

    <insert id="insertSeller">

        INSERT INTO sellers
        (
        user_id,
        user_name,
        user_email,
        user_phone,
        user_password,
        shop_name,
        shop_address
        )

        VALUES
        (
        #{userId},
        #{userName},
        #{userEmail},
        #{userPhNo},
        #{userPassword},
        #{shopName},
        #{shopAddress}
        )

    </insert>


    <!-- ===================================================== -->
    <!-- Update Seller -->
    <!-- ===================================================== -->

    <update id="updateSeller">

        UPDATE sellers

        SET
        user_name = #{userName},
        user_email = #{userEmail},
        user_phone = #{userPhNo},
        shop_name = #{shopName},
        shop_address = #{shopAddress}

        WHERE user_id = #{userId}

    </update>


    <!-- ===================================================== -->
    <!-- Update Password -->
    <!-- ===================================================== -->

    <update id="updatePassword">

        UPDATE sellers

        SET
        user_password = #{userPassword}

        WHERE user_id = #{userId}

    </update>


    <!-- ===================================================== -->
    <!-- Delete Seller -->
    <!-- ===================================================== -->

    <delete id="deleteSeller">

        DELETE FROM sellers

        WHERE user_id = #{sellerId}

    </delete>


    <!-- ===================================================== -->
    <!-- Find Seller By ID -->
    <!-- ===================================================== -->

    <select id="findSellerById"
            resultMap="SellerResultMap">

        SELECT
        s.user_id,
        s.user_name,
        s.user_email,
        s.user_phone,
        s.user_password,
        s.shop_name,
        s.shop_address

        FROM sellers s

        WHERE s.user_id = #{sellerId}

    </select>


    <!-- ===================================================== -->
    <!-- Find Seller By Email -->
    <!-- ===================================================== -->

    <select id="findSellerByEmail"
            resultMap="SellerResultMap">

        SELECT
        s.user_id,
        s.user_name,
        s.user_email,
        s.user_phone,
        s.user_password,
        s.shop_name,
        s.shop_address

        FROM sellers s

        WHERE s.user_email = #{email}

    </select>


    <!-- ===================================================== -->
    <!-- Find Seller By Phone -->
    <!-- ===================================================== -->

    <select id="findSellerByPhone"
            resultMap="SellerResultMap">

        SELECT
        s.user_id,
        s.user_name,
        s.user_email,
        s.user_phone,
        s.user_password,
        s.shop_name,
        s.shop_address

        FROM sellers s

        WHERE s.user_phone = #{phone}

    </select>


    <!-- ===================================================== -->
    <!-- Find All Sellers -->
    <!-- ===================================================== -->

    <select id="findAllSellers"
            resultMap="SellerResultMap">

        SELECT
        s.user_id,
        s.user_name,
        s.user_email,
        s.user_phone,
        s.user_password,
        s.shop_name,
        s.shop_address

        FROM sellers s

        ORDER BY s.user_name

    </select>


    <!-- ===================================================== -->
    <!-- Assign Address To Seller -->
    <!-- ===================================================== -->

    <insert id="assignAddressToSeller">

        INSERT INTO seller_address
        (
        seller_id,
        address_id
        )

        VALUES
        (
        #{sellerId},
        #{addressId}
        )

    </insert>


    <!-- ===================================================== -->
    <!-- Remove Address From Seller -->
    <!-- ===================================================== -->

    <delete id="removeAddressFromSeller">

        DELETE FROM seller_address

        WHERE seller_id = #{sellerId}

        AND address_id = #{addressId}

    </delete>


    <!-- ===================================================== -->
    <!-- Find Addresses By Seller -->
    <!-- ===================================================== -->

    <select id="findAddressesBySeller"
            resultMap="AddressResultMap">

        SELECT
        a.address_id,
        a.house_number,
        a.street,
        a.city,
        a.state,
        a.country,
        a.zip_code

        FROM address a

        INNER JOIN seller_address sa
        ON a.address_id = sa.address_id

        WHERE sa.seller_id = #{sellerId}

        ORDER BY a.city

    </select>


    <!-- ===================================================== -->
    <!-- Remove All Addresses From Seller -->
    <!-- ===================================================== -->

    <delete id="removeAllAddressesFromSeller">

        DELETE FROM seller_address

        WHERE seller_id = #{sellerId}

    </delete>
    
    <select id="findCustomersBySeller"
        resultType="com.crimsonlogic.ecommerce.model.Customer">

    SELECT DISTINCT

        c.user_id,
        c.user_name,
        c.user_email,
        c.user_phone,
        c.wallet_balance

    FROM customers c

    INNER JOIN orders o
        ON c.user_id = o.customer_id

    INNER JOIN products p
        ON o.product_id = p.product_id

    WHERE p.user_id = #{sellerId}

    ORDER BY c.user_name

</select>
</mapper>